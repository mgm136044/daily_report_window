# Copy to .env and fill in. .env is gitignored.
# Tighten the permissions after saving:  chmod 600 .env
#
# See docs/notion-setup.md (한국어: docs/notion-setup.ko.md) for how to obtain
# these values.

# Installation access token of a Notion *internal connection*.
# app.notion.com/developers/connections → Build → Internal connections →
# create one, then copy it from the Configuration tab.
# Do not use a personal access token (PAT): those expire, and the job then
# stops silently.
DAILY_REPORT_NOTION_TOKEN=

# URL of the page the report database will be created under.
# That page must be shared with the connection above: ••• → Add connections.
DAILY_REPORT_PARENT_PAGE_URL=

# Database ID printed by setup_notion_db.py — paste it back here after running it.
DAILY_REPORT_DATABASE_ID=
